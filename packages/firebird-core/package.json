  },
  "peerDependencies": {
    "three": ">=0.180.0"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "jsdom": "~30.1.2",
    "three": "^0.186.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
