{
  "name": "@dexvis/root2dex",
  "version": "0.0.1",
  "description": "Converts EDM4eic / EDM4hep podio ROOT files to Firebird DEX using the JSROOT API. Plain worker-safe TypeScript; reads only the bytes of the requested event.",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./entries": "./src/entries.ts"
  },
  "scripts": {
    "test": "vitest run"
  },
  "peerDependencies": {
    "jsroot": ">=7.11.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "jsroot": "7.11.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
